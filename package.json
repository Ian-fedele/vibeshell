{
  "name": "vibeshell",
  "version": "0.0.1",
  "description": "An open-source, terminal-first agentic coding assistant.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "vibeshell": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --clean --external node-pty",
    "dev": "concurrently -k -n engine,desktop -c cyan,magenta \"pnpm dev:engine\" \"pnpm dev:desktop\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev:engine": "PATH=\"$HOME/.grok/bin:$HOME/.cargo/bin:$PATH\" tsx src/server.ts",
    "dev:desktop": "PATH=\"$HOME/.cargo/bin:$HOME/.grok/bin:$PATH\" pnpm -C desktop tauri dev"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "claude",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ian-fedele/vibeshell.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "node-pty": "^1.1.0",
    "openai": "^7.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
